# --- Required ---------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=your_token_here
# From https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# --- Recommended -------------------------------------------------------------
# Your capture channel's id (starts with -100). The bot ignores every other chat.
TELEGRAM_CHAT_ID=
# Any random string. Pass the same value as secret_token when you call setWebhook
# so only Telegram can hit /api/webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Memory (B1·3) -----------------------------------------------------------
# Supabase > Project Settings > API. Use the service_role key (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Model choices -----------------------------------------------------------
# Scoring, keywords and transcription always use Gemini Flash.
# GEMINI_MODEL=gemini-3.8-flash
# Drafting: gemini (default) or claude (for the B1 model comparison)
DRAFT_PROVIDER=gemini
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
